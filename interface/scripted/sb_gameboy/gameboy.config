{
  "gui": {
    "background": {
      "zlevel": 0,
      "type": "background",
      "fileHeader": "/interface/scripted/sb_gameboy/header.png",
      "fileBody": "/interface/scripted/sb_gameboy/body.png",
      "fileFooter": "/interface/scripted/sb_gameboy/footer.png"
    },
    "windowtitle": {
      "type": "title",
      "title": "^font=pixelhobo;Handheld Gaming System^reset;",
      "subtitle": "^font=pixelhobo;Choose a game^reset;",
      "icon": {
        "type": "image",
        "file": "/interface/scripted/sb_gameboy/titleicon.png",
        "zlevel": -1
      }
    },
    "gameScrollArea": {
      "type": "scrollArea",
      "rect": [4, 48, 184, 148],
      "children": {
        "gameList": {
          "type": "list",
          "callback": "itemSelected",
          "schema": {
            "selectedBG": "/interface/scripted/sb_gameboy/gameselected.png?scalenearest=1.3;1",
            "unselectedBG": "/interface/scripted/sb_gameboy/gamebackground.png?scalenearest=1.3;1",
            "spacing": [0, 1],
            "memberSize": [169, 9],
            "listTemplate": {
              "background": {
                "type": "image",
                "file": "/interface/scripted/sb_gameboy/gamebackground.png?scalenearest=1.3;1",
                "position": [0, 0],
                "zlevel": -1
              },
              "gameName": {
                "type": "label",
                "position": [2, 0],
                "hAnchor": "left",
                "width": 138,
                "value": ""
              }
            }
          }
        }
      }
    },

    "play": {
      "type": "button",
      "base": "/interface/button.png",
      "hover": "/interface/buttonhover.png",
      "caption": "^font=pixelhobo;Play^reset;",
      "disabled": true,
      "pressedOffset": [0, -1],
      "position": [68, 25],
      "callback": "play"
    },
    "close": {
      "type": "button",
      "base": "/interface/x.png",
      "hover": "/interface/xhover.png",
      "pressed": "/interface/xpress.png",
      "pressedOffset": [0, 0],
      "callback": "close",
      "position": [171, 161]
    }
  },

  "scriptWidgetCallbacks": ["play", "itemSelected"],
  "scripts": ["/interface/scripted/sb_gameboy/gameboy.lua"],
  "gameNameFormat": "^font=pixelhobo;%s^reset;",
  "games": [
    ["Pong", "/interface/games/sb_pong/game.config"],
    ["Lights Off", "/interface/games/sb_lightsoff/game.config"]
  ]
}
